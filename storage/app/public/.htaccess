# Defense-in-depth: cegah eksekusi script apapun di folder upload,
# meskipun validasi ekstensi di PHP (config/uploads.php) sudah membatasi
# hanya ekstensi aman yang bisa diupload.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php\d?|phar|pl|py|cgi|asp|aspx|sh|exe)$">
    Require all denied
</FilesMatch>

Options -ExecCGI
AddHandler default-handler .php .phtml .pl .py .cgi .asp .aspx
