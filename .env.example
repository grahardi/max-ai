APP_NAME="Max AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ==========================
# PostgreSQL Database
# ==========================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=max_ai
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# ==========================
# Remove Background microservice (Python + rembg)
# Jalankan python-service/main.py secara terpisah, lalu isi URL-nya di sini
# ==========================
REMBG_SERVICE_URL=http://127.0.0.1:8001
REMBG_TIMEOUT=60

MAIL_MAILER=log
